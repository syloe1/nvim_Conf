# Vendored plugins for offline installs — not shipped (large). When absent,
# NeoVim clones plugins from GitHub on first launch.
/predownload

# Personal dotfiles kept alongside the config locally — never published.
/dotfiles

# Generated by packer.nvim; contains machine-specific absolute paths.
/plugin

# Local overrides.
/.vim_localrc

# Upstream archibate/vimrc ignores these too.
/.build_cache
/a.out
__pycache__/
*.backup.*
